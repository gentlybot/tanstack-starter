# Copy to .env.local for local development.
# On gently, DATABASE_URL is injected automatically by the postgres service
# in gently/apps.yml, and API keys are set as workspace secrets.

# Postgres connection string
DATABASE_URL=postgres://app:app@localhost:5432/app

# Enables the AI chat at /chat (Anthropic preferred, OpenAI works too)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
