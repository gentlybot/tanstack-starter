# Copy to .env for local development (TanStack Start/Vite, drizzle-kit, and
# the standalone worker/ws processes all load it).
# On gently, DATABASE_URL is injected automatically by the postgres service
# declared in gently/apps.yml.

# Postgres connection string (the only required variable).
DATABASE_URL=postgres://app:app@localhost:5432/app

# Port for the standalone WebSocket server (npm run ws). If you change it,
# update the /ws proxy target in vite.config.ts too.
# WS_PORT=3001
